{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["vitest/globals"],
    "moduleResolution": "bundler",
    "paths": {
      "@better-vitty/captcha-solver": ["./packages/captcha-solver/src/index.ts"]
    }
  },
  "include": ["App.tsx", "src/**/*.ts", "src/**/*.tsx", "packages/*/src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
