{
  "expo": {
    "name": "Better Vitty",
    "slug": "better-vitty",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "better-vitty",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "foo.ashman.bettervitty",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Better Vitty to scan timetable QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Better Vitty to import timetable QR images."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2ba14abd-bf77-4061-b14e-61412fdaca86"
      }
    },
    "owner": "123karan1234"
  }
}
